COHERE_API_KEY=your_cohere_api_key_here

# Token HuggingFace — requis pour la diarisation (PyAnnote)
# Obtenez le vôtre sur : https://huggingface.co/settings/tokens
# Puis acceptez les conditions : https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=your_huggingface_token_here

# Taille du modèle Whisper : tiny | base | small | medium
# small = bon équilibre vitesse/précision (recommandé)
WHISPER_MODEL=small

MAX_FILE_SIZE_MB=125
TEMP_DIR=./temp

# ─── Authentification & crédits ──────────────────────────────────
# Code admin fixe (optionnel). Si vide, un code aléatoire sera généré
# au premier démarrage et imprimé dans la console.
ADMIN_CODE=ADMIN-1122

# Crédits offerts par défaut à chaque nouvel utilisateur
DEFAULT_CREDITS=30

# Coût d'une transcription
COST_SIMPLE=5
COST_DIARIZE=10

# Contact admin affiché à l'utilisateur quand ses crédits sont épuisés
# (email, lien WhatsApp, etc.)
ADMIN_CONTACT=

# Cookies sécurisés (HTTPS uniquement) — mettre à true en production
COOKIE_SECURE=false

# SameSite policy. "lax" pour dev local, "none" si frontend et API sont
# sur des sous-domaines différents (ex. transcription.x.com / api.x.com)
# "none" nécessite COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# Origines autorisées (séparées par virgule). Vide = liste par défaut
# (production + localhost). À renseigner si frontend hébergé ailleurs.
ALLOWED_ORIGINS=

# Dossier où stocker la base SQLite (auth.db).
# En Docker, mettre /data (avec volume monté). En local, laisser vide.
DATA_DIR=

# ─── Paiement Chariow ────────────────────────────────────────────
# Clé API Chariow (sk_live_... ou sk_test_...). Obtenir via :
# Dashboard Chariow → Settings → API Keys → Create API Key
# ⚠️ N'exposez JAMAIS cette clé côté frontend.
CHARIOW_API_KEY=

# IDs des produits Chariow (prd_xxx ou slug). Créez les produits dans
# le dashboard Chariow puis renseignez leurs identifiants ici.
CHARIOW_PRODUCT_ID_STANDARD=
CHARIOW_PRODUCT_ID_PREMIUM=

# Crédits accordés après un paiement réussi par plan.
CREDITS_STANDARD=200
CREDITS_PREMIUM=500

# Devise des paiements (ISO 4217). XOF = Franc CFA d'Afrique de l'Ouest.
PAYMENT_CURRENCY=XOF

# URL publique de votre application — utilisée pour les redirections
# post-paiement et l'URL du webhook envoyée à Chariow.
# Exemple : https://transcription.mapharmadegarde.com
PUBLIC_BASE_URL=http://localhost:8000

# Secret partagé dans l'URL du webhook Chariow (ex: chaîne aléatoire de 32+
# caractères). À configurer dans Chariow Dashboard → Automation → Pulses :
#   URL = https://VOTRE_DOMAINE/webhooks/chariow/VOTRE_SECRET
# Génère-le avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
CHARIOW_WEBHOOK_SECRET=
