COHERE_API_KEY=your_cohere_api_key_here

# Token HuggingFace — requis pour la diarisation (PyAnnote)
# Obtenez le vôtre sur : https://huggingface.co/settings/tokens
# Puis acceptez les conditions : https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=your_huggingface_token_here

# Taille du modèle Whisper : tiny | base | small | medium
# small = bon équilibre vitesse/précision (recommandé)
WHISPER_MODEL=small

MAX_FILE_SIZE_MB=125
TEMP_DIR=./temp
